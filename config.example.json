{
  "api_endpoint": "https://api.deepseek.com",
  "api_key": "your-api-key-here",
  "api_model": "deepseek-v4-flash",
  "thinking": "disabled",
  "max_tokens": 512,
  "temperature": 0.8,
  "allowed_origins": [
    "http://你的穿透域名.com"
  ],
  "allowed_read_paths": ["D:\\音乐", "D:\\桌面", "D:\\文档", "."],
  "monitor_enabled": true,
  "prompt_cache_ttl_seconds": 60,
  "conversation_examples_max_turns": 3,
  "use_memory_agent": false,
  "memory_agent_relevance_floor": 0.35,
  "memory_agent_relevance_full": 0.75,
  "memory_agent_coreference_threshold": 0.78,
  "proactive_think_loop": true,
  "proactive_think_max_rounds": 2,
  "inner_drive_care_list_size": 20,
  "inner_drive_surface_top_k": 8,
  "inner_drive_surface_response_k": 3,
  "inner_drive_decay_rate": 0.9,
  "emotion_turn_seconds": 300,
  "inner_drive_care_similarity_threshold": 0.7,
  "agent2_total_timeout_seconds": 120,
  "web_access_token": "",
  "db_backup_enabled": true,
  "db_backup_keep": 5
}
